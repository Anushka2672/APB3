`timescale 1ns / 1ps

module edge_detector(
    input  wire clk,
    input  wire rst,
    input  wire signal_in,
    output reg  pulse
);

    reg signal_prev;

    always @(posedge clk or posedge rst) begin

        if (rst) begin
            signal_prev <= 1'b0;
            pulse       <= 1'b0;
        end

        else begin

            // Rising-edge detection
            pulse       <= signal_in & ~signal_prev;
            signal_prev <= signal_in;

        end

    end

endmodule
